# Production login. Set both values. Format: scrypt:<16-byte salt hex>:<32-byte digest hex>.
# NODEGUARD_ADMIN_USER=admin
# NODEGUARD_ADMIN_PASSWORD_HASH=scrypt:REPLACE_WITH_SALT:REPLACE_WITH_DIGEST
# Local demo only. Set a different random 32-byte hex token for every enabled operator.
# NODEGUARD_USER_TOKENS='{"usr-reza":"REPLACE_WITH_RANDOM_HEX"}'
NODEGUARD_WORKSPACE_MODE=simulation

# Optional. Keep the SQLite file on a local, durable disk.
# NODEGUARD_DB_PATH=.nodeguard/simulation.sqlite
# NODEGUARD_ORIGIN=http://127.0.0.1:3000
# NODEGUARD_SECURE_COOKIE=1

# Optional monitor configuration. Use a new SQLite file for monitor.
# NODEGUARD_WORKSPACE_MODE=monitor
# NODEGUARD_INVENTORY_PATH=inventory.example.json
# NODEGUARD_PROXY_OBSERVERS='{"node-1":["observer-1","observer-2"]}'
# NODEGUARD_ENABLE_IPERF=1
# NODEGUARD_IPERF_TARGETS='{"tun-main":{"receiverServerId":"exit-1","port":5201}}'
# To offer both endpoints as test destinations, enroll an iperf3 listener on each host.
# NODEGUARD_IPERF_TARGETS='{"tun-main":[{"receiverServerId":"exit-1","port":5201},{"receiverServerId":"ir-main","port":5201}]}'
# NODEGUARD_AGENT_TOKENS='{"ir-main":"REPLACE_WITH_RANDOM_AGENT_HEX"}'

# Optional read-only providers, available in monitor mode.
# Random 32-byte hex key for V2Board admin sessions entered through the UI.
# NODEGUARD_CREDENTIAL_KEY=REPLACE_WITH_RANDOM_64_HEX
# NODEGUARD_V2BOARD_ENDPOINT=https://panel.example/api/v1/ADMIN_PATH/server/manage/getNodes
# NODEGUARD_V2BOARD_AUTH=REPLACE_WITH_AUTHORIZATION_HEADER_VALUE
# NODEGUARD_V2BOARD_MAP='{"vless:123":"node-1"}'
# Optional catalog worker. Use an independent random 64-hex token.
# NODEGUARD_ENABLE_V2BOARD_MONITOR=1
# NODEGUARD_V2BOARD_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_HEX
# NODEGUARD_V2BOARD_POLL_SECONDS=300
# NODEGUARD_CF_ZONE_ID=00000000000000000000000000000000
# NODEGUARD_CF_TOKEN=REPLACE_WITH_ZONE_DNS_READ_TOKEN
# NODEGUARD_ARVAN_ZONES='["example.ir"]'
# NODEGUARD_ARVAN_TOKEN=REPLACE_WITH_ARVAN_API_KEY
# Optional. Recursive DNS addresses used by both monitor checks and failover verification.
# NODEGUARD_DNS_RESOLVERS='["1.1.1.1","2606:4700:4700::1111"]'
# Optional background DNS observations. Keep this random 64-hex token separate from user and agent tokens.
# NODEGUARD_ENABLE_DNS_MONITOR=1
# NODEGUARD_DNS_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_HEX
# NODEGUARD_DNS_POLL_SECONDS=120
# Optional Agent heartbeat alerts. Use a separate random 64-hex token.
# NODEGUARD_ENABLE_HEALTH_MONITOR=1
# NODEGUARD_HEALTH_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_HEX

# Optional Cloudflare DNS execution for enrolled records only
# NODEGUARD_ENABLE_DNS_FAILOVER=1
# NODEGUARD_ENABLE_AUTO_FAILOVER=1
# Optional standby preparation. Requires a pre-installed foreign profile and an idle Iran backup.
# NODEGUARD_ENABLE_AUTO_STANDBY=1
# NODEGUARD_AUTO_STANDBY_TUNNELS='{"node-1":"tun-backup"}'
# Optional host Provision and Telegram delivery
# NODEGUARD_ENABLE_PROVISION=1
# NODEGUARD_ENABLE_SSH_INSTALL=1
# NODEGUARD_BUILD_PYTHON=/usr/bin/python3
# NODEGUARD_PROVISION_PROFILES='[{"id":"bbr-lab","serverId":"exit-1","component":"BBR","version":"1.0","sha256":"REPLACE_WITH_SHA256","summary":"Canary BBR profile"}]'
# NODEGUARD_TUNNEL_PROFILES='[{"tunnelId":"tun-main","iranProfileId":"gre-in","foreignProfileId":"gre-out"}]'
# NODEGUARD_ENABLE_TELEGRAM=1
# NODEGUARD_TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
# NODEGUARD_TELEGRAM_CHAT_ID=REPLACE_WITH_NUMERIC_CHAT_ID
# NODEGUARD_TELEGRAM_WORKER_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_TOKEN

# NODEGUARD_CF_WRITE_TOKEN=REPLACE_WITH_ZONE_DNS_WRITE_TOKEN
# NODEGUARD_CF_FAILOVER_RECORDS='{"node-1":"0123456789abcdef0123456789abcdef"}'
# NODEGUARD_CONTROL_URL=http://127.0.0.1:3000
# NODEGUARD_FAILOVER_WORKER_TOKEN=REPLACE_WITH_INDEPENDENT_64_HEX_TOKEN
