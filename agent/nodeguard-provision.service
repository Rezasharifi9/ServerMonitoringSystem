# Managed by the NodeGuard Agent installer.
[Unit]
Description=NodeGuard provision worker for approved host packages
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=root
ExecStart=/usr/bin/python3 -B -s /opt/nodeguard/agent/provision_worker.py /etc/nodeguard/agent.json --token-file /etc/nodeguard/agent.token
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
