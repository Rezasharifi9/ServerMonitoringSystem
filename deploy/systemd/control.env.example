# Copy to /etc/nodeguard/control-plane/control.env with mode 0600 and owner root.
NODEGUARD_WORKSPACE_MODE=simulation
NODEGUARD_DB_PATH=/var/lib/nodeguard-control/simulation.sqlite
# NODEGUARD_USER_TOKENS='{"usr-reza":"REPLACE_WITH_RANDOM_64_HEX"}'
# NODEGUARD_ORIGIN=https://nodeguard.example
# NODEGUARD_SECURE_COOKIE=1
# NODEGUARD_CREDENTIAL_KEY=REPLACE_WITH_RANDOM_64_HEX
# For monitor, change NODEGUARD_WORKSPACE_MODE and NODEGUARD_DB_PATH together:
# NODEGUARD_INVENTORY_PATH=/etc/nodeguard/control-plane/inventory.json
# See .env.example for optional capabilities and provider settings.
